# ============================================================
# SENSITIVE / SECRET FILES  ← never commit these
# ============================================================
.env
.env.*
!.env.example          # allow a safe template to be committed
*.pem
*.key
*.p12
*.pfx
secrets.yaml
secrets.json

# ============================================================
# GENERATED OUTPUTS  ← runtime artefacts, not source
# ============================================================
outputs/

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Coverage & testing
.coverage
.coverage.*
htmlcov/
.tox/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# MyPy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# Jupyter
.ipynb_checkpoints/

# ============================================================
# JAVA / MAVEN / GRADLE  (reference files)
# ============================================================
target/
*.class
*.jar
*.war
*.ear
*.nar
.gradle/
gradle-wrapper.jar
hs_err_pid*

